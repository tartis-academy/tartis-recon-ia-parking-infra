# Variables del stack de DEMO (docker-compose.demo.yml): base de datos
# dedicada por microservicio (perfil prod real, no el Postgres compartido de
# dev). Copia a .env.demo antes de levantar:
#   cp .env.demo.example .env.demo

# Puertos de host 8080-8084 alineados con postman/Parking-Local.postman_environment.json

# --- vehicle-service ---
VEHICLE_DB_NAME=vehicle_db
VEHICLE_DB_USER=vehicle
VEHICLE_DB_PASSWORD=change.me
VEHICLE_DB_PORT=5433
VEHICLE_PORT=8080

# --- spot-service ---
SPOT_DB_NAME=spot_db
SPOT_DB_USER=spot
SPOT_DB_PASSWORD=change.me
SPOT_DB_PORT=5434
SPOT_PORT=8081

# --- tariff-service ---
TARIFF_DB_NAME=tariff_db
TARIFF_DB_USER=tariff
TARIFF_DB_PASSWORD=change.me
TARIFF_DB_PORT=5435
TARIFF_PORT=8082

# --- ticket-service ---
TICKET_DB_NAME=ticket_db
TICKET_DB_USER=ticket
TICKET_DB_PASSWORD=change.me
TICKET_DB_PORT=5436
TICKET_PORT=8083

# --- stay-service ---
STAY_DB_NAME=stay_db
STAY_DB_USER=stay
STAY_DB_PASSWORD=change.me
STAY_DB_PORT=5437
STAY_PORT=8084

# --- frontend ---
FRONTEND_PORT=8090
