# Variables de todo el stack (herramientas compartidas + Fase II + demo).
# Copia a .env antes de levantar:
#   cp .env.example .env
#
# Los valores de aquí son de LOCAL (contraseñas change.me incluidas). Ver
# "Dev vs producción" en el README para qué de esto no debería salir de un
# portátil.

# ============================================================
# SOLO LOCAL — Postgres compartido de dev + pgAdmin
# (docker-compose.dev.yml, no forma parte del stack full/demo)
# ============================================================

# --- Postgres compartido de DEV ---
DB_NAME=parking_dev
DB_USER=parking_dev
DB_PASSWORD=change.me
DB_PORT=5432

# --- pgAdmin ---
PGADMIN_EMAIL=admin@tartis.com
PGADMIN_PASSWORD=change.me
PGADMIN_PORT=5050

# ============================================================
# Plataforma y microservicios — misma forma en cualquier entorno,
# solo cambiarían los valores (secretos, puertos, hosts)
# ============================================================

# --- Keycloak ---
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change.me
KEYCLOAK_DB_PORT=5438
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change.me
KEYCLOAK_PORT=8180

# --- RabbitMQ ---
RABBITMQ_USER=parking
RABBITMQ_PASSWORD=change.me
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MGMT_PORT=15672

# --- Kong ---
KONG_PROXY_PORT=8000
KONG_ADMIN_PORT=8001

# --- vehicle-service ---
# Sin puerto de host propio (GW-07): solo alcanzable via Kong o red interna.
VEHICLE_DB_NAME=vehicle_db
VEHICLE_DB_USER=vehicle
VEHICLE_DB_PASSWORD=change.me
VEHICLE_DB_PORT=5433

# --- spot-service ---
SPOT_DB_NAME=spot_db
SPOT_DB_USER=spot
SPOT_DB_PASSWORD=change.me
SPOT_DB_PORT=5434

# --- tariff-service ---
TARIFF_DB_NAME=tariff_db
TARIFF_DB_USER=tariff
TARIFF_DB_PASSWORD=change.me
TARIFF_DB_PORT=5435

# --- ticket-service ---
TICKET_DB_NAME=ticket_db
TICKET_DB_USER=ticket
TICKET_DB_PASSWORD=change.me
TICKET_DB_PORT=5436

# --- stay-service ---
STAY_DB_NAME=stay_db
STAY_DB_USER=stay
STAY_DB_PASSWORD=change.me
STAY_DB_PORT=5437

# --- frontend ---
FRONTEND_PORT=8090
