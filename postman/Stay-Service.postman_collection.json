        "description": "`plate` vacia -> **400 Bad Request** por `@NotBlank` (`MethodArgumentNotValidException`).\n\nEl mensaje viene como `campo: motivo`, p. ej. `plate: La matricula es obligatoria`.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"plate\": \"\",\n  \"vehicleType\": \"CAR\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
              "pm.test('menciona el campo plate', () => pm.expect(pm.response.json().message).to.include('plate'));"
            ]
          }
        }
      ]
    },
